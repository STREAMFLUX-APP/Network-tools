{
"version": 2,
"builds": [
{ "src": "*.js", "use": "@vercel/node" },
{ "src": "public/**", "use": "@vercel/static" }
],
"routes": [
{ "src": "/api/auth", "dest": "/auth.js" },
{ "src": "/api/claude", "dest": "/claude.js" },
{ "src": "/api/admin", "dest": "/admin.js" },
{ "src": "/(.*)", "dest": "/public/$1" }
]
}
