{
"version": 2,
"builds": [
{ "src": "api/*.js", "use": "@vercel/node" },
{ "src": "public/**", "use": "@vercel/static" }
],
"routes": [
{ "src": "/api/(.*)", "dest": "/api/$1.js" },
{ "src": "/marketing.html", "dest": "/public/marketing.html" },
{ "src": "/marketing", "dest": "/public/marketing.html" },
{ "src": "/outreach.html", "dest": "/public/outreach.html" },
{ "src": "/outreach", "dest": "/public/outreach.html" },
{ "src": "/(.*)", "dest": "/public/$1" }
]
}
