</style>
</head>
<body>
<div id="root"></div>
<script type="text/babel">
const { useState, useEffect } = React;

const G = {
bg:"#0a0c0f", card:"#13161b", border:"#1e2330",
purple:"#7664d0", purpleDim:"#2e2a4a", purpleLight:"#ede9ff",
text:"#e8eaf0", muted:"#6b7280", green:"#2d9e6b", glight:"#e6f7f1",
red:"#dc2626", redLight:"#1a0a0a",
};

const LANGS=[{value:"English",label:"🇺🇸 English"},{value:"Spanish",label:"🇪🇸 Español (España)"},{value:"Mexican",label:"🇲🇽 Español (México)"},{value:"Italian",label:"🇮🇹 Italiano"},{value:"French",label:"🇫🇷 Français"},{value:"Portuguese",label:"🇧🇷 Português"},{value:"German",label:"🇩🇪 Deutsch"},{value:"Arabic",label:"🇦🇪 العربية"},{value:"Chinese",label:"🇨🇳 中文"}];

const CONTACT_TYPES=[
{value:"potential_customer",label:"🛍️ Potential Customer",desc:"Interested in buying MONAT products"},
{value:"potential_partner",label:"🤝 Potential Partner",desc:"Might want to join as a Market Partner"},
{value:"existing_customer",label:"💎 Existing Customer",desc:"Already bought products before"},
{value:"cold_lead",label:"❄️ Cold Lead",desc:"No prior contact — first outreach"},
{value:"past_partner",label:"🔄 Past Partner",desc:"Used to be a Market Partner"},
{value:"team_member",label:"🌟 Team Member",desc:"Part of your MONAT team"},
];

const CONTACT_REASONS=[
{value:"first_outreach",label:"👋 First Outreach",desc:"Never contacted them before"},
{value:"follow_up_interest",label:"🔥 Follow Up — Showed Interest",desc:"They liked something or asked about it"},
{value:"follow_up_no_reply",label:"👻 Follow Up — No Reply",desc:"Sent a message, heard nothing back"},
{value:"product_recommendation",label:"💊 Product Recommendation",desc:"Recommending a specific product for their problem"},
{value:"recruit_invite",label:"🚀 Recruit — Business Invite",desc:"Inviting them to join as a Market Partner"},
{value:"repeat_sale",label:"🔁 Repeat Sale / Reorder",desc:"Their product is running out or they need more"},
{value:"special_offer",label:"🎁 Special Offer / Promotion",desc:"Sharing a current deal or promotion"},
{value:"check_in",label:"💬 Check In",desc:"Just keeping in touch"},
{value:"handle_objection",label:"🛡️ Handle Objection",desc:"They said no or not right now"},
{value:"welcome_new",label:"🎉 Welcome New Customer/Partner",desc:"They just joined or bought for the first time"},
{value:"referral_request",label:"🙏 Ask for Referral",desc:"Ask them to refer friends or family"},
{value:"reconnect",label:"🔗 Reconnect",desc:"Haven't spoken in a long time"},
];

const HAIR_PROBLEMS=[
"Hair Thinning & Loss","Dry & Brittle Hair","Frizzy & Unmanageable Hair",
"Oily Hair & Scalp","Damaged Hair & Breakage","Split Ends",
"Undefined Curls & Waves","Color-Treated Hair Fade","Flat Hair & No Volume",
"Itchy / Flaky Scalp","Aging Skin & Wrinkles","Dull & Uneven Skin",
];

const PRODUCTS=[
"MONAT Bond IQ™","IR Clinical™","Rejuveniqe Oil Intensive™","Smoothing Anti-Frizz™",
"MONAT Curl Perfection™","REJUVABEADS®","Scalp Purifying Scrub","Scalp Comfort™",
"MONAT Color Care","MONAT Densifying System","MONAT Barrier Booster™",
"MONAT GlowTint™ Lip Oil","MONAT Wellness Supplements","MONAT for MEN™",
];

const PARTNER_TARGETS=[
"Wants Extra Income","Loves Beauty & Hair","Stay-at-Home Mom",
"Work From Home","Looking for a Side Hustle","Active on Social Media",
"Entrepreneur Mindset","Student / Young Professional","Recently Lost Job",
"Passionate About Natural Products",
];

const OBJECTIONS=[
{value:"too_expensive",label:"Too Expensive",desc:"Can't afford it right now"},
{value:"not_interested",label:"Not Interested",desc:"General rejection"},
{value:"already_have_products",label:"Already Have Products",desc:"Using another brand"},
{value:"mlm_skeptical",label:"Skeptical About MLM",desc:"Doesn't believe in network marketing"},
{value:"no_time",label:"No Time",desc:"Too busy to sell or try products"},
{value:"need_to_think",label:"Need to Think About It",desc:"Not ready to decide"},
{value:"bad_timing",label:"Bad Timing",desc:"Life circumstances not right"},
{value:"tried_before",label:"Tried It Before",desc:"Had a bad experience with MONAT or MLM"},
];

const TONES=[
{value:"warm",label:"Warm & Personal",desc:"Friendly, human, relationship-first"},
{value:"professional",label:"Professional",desc:"Polished, credible, clear"},
{value:"excited",label:"Excited & Enthusiastic",desc:"High energy, passionate"},
{value:"casual",label:"Casual & Relaxed",desc:"Low pressure, just checking in"},
{value:"urgent",label:"Urgent & Direct",desc:"Time-sensitive, act now"},
];

const TABS=[
{id:"messages",label:"💬 WhatsApp & SMS"},
{id:"voice",label:"🎙️ Voice Script"},
{id:"email",label:"📧 Email"},
{id:"letter",label:"✉️ Formal Letter"},
{id:"followups",label:"🔄 Follow-Ups"},
{id:"schedule",label:"📅 Schedule"},
];

const callAuth=async(body)=>{const r=await fetch("/api/auth",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});return r.json();};
const callClaude=async(prompt,maxTokens=1300)=>{const r=await fetch("/api/claude",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({prompt,maxTokens})});const d=await r.json();if(d.error)throw new Error(d.error);if(!d.result)throw new Error("No result from AI");return d.result;};

function Field({label,hint,value,onChange,placeholder,type="text",rows}){
const s={width:"100%",background:"#0d1017",border:`1px solid ${G.border}`,borderRadius:8,color:G.text,fontSize:14,padding:"11px 14px",outline:"none",boxSizing:"border-box",fontFamily:"inherit"};
return <div style={{marginBottom:16}}>
<label style={{display:"block",fontSize:10,fontWeight:700,letterSpacing:"0.1em",color:G.muted,textTransform:"uppercase",marginBottom:3}}>{label}</label>
{hint&&<p style={{fontSize:11,color:"#4b5563",margin:"0 0 5px",fontStyle:"italic"}}>{hint}</p>}
{rows?<textarea value={value} onChange={e=>onChange(e.target.value)} placeholder={placeholder} rows={rows} style={{...s,resize:"vertical"}}/>
:<input type={type} value={value} onChange={e=>onChange(e.target.value)} placeholder={placeholder} style={s}/>}
</div>;
}

function Chips({label,hint,opts,sel,toggle,single=false}){
return <div style={{marginBottom:18}}>
<label style={{display:"block",fontSize:10,fontWeight:700,letterSpacing:"0.1em",color:G.muted,textTransform:"uppercase",marginBottom:3}}>{label}</label>
{hint&&<p style={{fontSize:11,color:"#4b5563",margin:"0 0 6px",fontStyle:"italic"}}>{hint}</p>}
<div style={{display:"flex",flexWrap:"wrap",gap:7}}>
{opts.map(o=>{
const v=typeof o==="string"?o:o.value,l=typeof o==="string"?o:o.label,d=typeof o==="object"?o.desc:null;
const active=single?sel===v:(Array.isArray(sel)&&sel.includes(v));
return <button key={v} onClick={()=>toggle(v)} style={{background:active?"#1a1a2e":"#0d1017",border:`1px solid ${active?G.purple:G.border}`,borderRadius:7,color:active?"#b8aff0":"#9ca3af",fontSize:12,padding:d?"9px 13px":"7px 12px",cursor:"pointer",textAlign:"left"}}>
<div style={{fontWeight:active?700:400}}>{l}</div>
{d&&<div style={{fontSize:11,color:active?"#7664d0":G.muted,marginTop:2}}>{d}</div>}
</button>;
})}
</div>
</div>;
}

function OutCard({title,content,badge}){
const[cp,setCp]=useState(false);
if(!content)return null;
return <div style={{background:"#0d1017",border:`1px solid ${G.border}`,borderRadius:10,padding:"15px 17px",marginBottom:12}}>
<div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:9}}>
<div style={{display:"flex",alignItems:"center",gap:7}}>
<span style={{fontSize:10,fontWeight:700,letterSpacing:"0.1em",color:G.purple,textTransform:"uppercase"}}>{title}</span>
{badge&&<span style={{fontSize:10,background:"#1a1a2e",color:"#7664d0",border:"1px solid #2e2a4a",borderRadius:4,padding:"2px 7px"}}>{badge}</span>}
</div>
<button onClick={()=>{navigator.clipboard.writeText(content);setCp(true);setTimeout(()=>setCp(false),1800);}} style={{background:cp?"#1a2a1a":"#13161b",border:`1px solid ${cp?"#2a5a2a":G.border}`,borderRadius:6,color:cp?"#4caf50":"#9ca3af",fontSize:11,padding:"4px 12px",cursor:"pointer"}}>
{cp?"✓ Copied":"Copy"}
</button>
</div>
<p style={{color:"#d1d5db",fontSize:14,lineHeight:1.75,margin:0,whiteSpace:"pre-wrap"}}>{content}</p>
</div>;
}

function Login({onLogin}){
const[em,setEm]=useState(""),[pw,setPw]=useState(""),[loading,setL]=useState(false),[err,setErr]=useState("");
const go=async()=>{if(!em||!pw){setErr("Please enter email and password.");return;}setL(true);setErr("");const d=await callAuth({action:"login",email:em,password:pw});setL(false);if(d.success){localStorage.setItem("nt_u",JSON.stringify(d.user));onLogin(d.user);}else setErr(d.error||"Invalid credentials.");};
return <div style={{minHeight:"100vh",background:G.bg,display:"flex",alignItems:"center",justifyContent:"center",padding:20}}>
<div style={{width:"100%",maxWidth:400}}>
<div style={{textAlign:"center",marginBottom:24}}>
<div style={{width:54,height:54,borderRadius:14,background:G.purpleDim,border:`1px solid ${G.purple}`,display:"flex",alignItems:"center",justifyContent:"center",fontSize:26,margin:"0 auto 12px"}}>✦</div>
<div style={{fontSize:20,fontWeight:"bold",letterSpacing:2,color:G.text}}>Network Tools</div>
<div style={{fontSize:12,color:G.muted,marginTop:2}}>Outreach Machine by Streamflux</div>
</div>
<div style={{background:G.card,border:`1px solid ${G.border}`,borderRadius:16,padding:"26px 22px"}}>
<h2 style={{fontSize:17,fontWeight:700,textAlign:"center",marginBottom:4,color:G.text}}>Welcome back</h2>
<p style={{fontSize:13,color:G.muted,textAlign:"center",marginBottom:20}}>Sign in to your account</p>
<label style={{fontSize:10,color:G.muted,display:"block",marginBottom:4,fontWeight:700,textTransform:"uppercase"}}>Email</label>
<input type="email" value={em} onChange={e=>setEm(e.target.value)} placeholder="your@email.com" onKeyDown={e=>e.key==="Enter"&&go()} style={{width:"100%",padding:"11px 13px",borderRadius:9,boxSizing:"border-box",background:"#0d1017",border:`1px solid ${G.border}`,fontSize:14,outline:"none",color:G.text,fontFamily:"inherit",marginBottom:12}}/>
<label style={{fontSize:10,color:G.muted,display:"block",marginBottom:4,fontWeight:700,textTransform:"uppercase"}}>Password</label>
<input type="password" value={pw} onChange={e=>setPw(e.target.value)} placeholder="••••••••" onKeyDown={e=>e.key==="Enter"&&go()} style={{width:"100%",padding:"11px 13px",borderRadius:9,boxSizing:"border-box",background:"#0d1017",border:`1px solid ${G.border}`,fontSize:14,outline:"none",color:G.text,fontFamily:"inherit",marginBottom:16}}/>
{err&&<div style={{background:G.redLight,border:"1px solid #3a1a1a",borderRadius:8,padding:"9px 12px",marginBottom:12,color:"#f87171",fontSize:13}}>⚠️ {err}</div>}
<button onClick={go} disabled={loading} style={{width:"100%",padding:"13px",borderRadius:10,border:"none",background:loading?"#1a1a2e":G.purple,color:loading?G.muted:"#fff",fontSize:14,fontWeight:700,cursor:loading?"not-allowed":"pointer"}}>
{loading?"Signing in...":"Sign In →"}
</button>
<p style={{fontSize:11,color:G.muted,textAlign:"center",marginTop:14}}>Need help? <span style={{color:G.purple}}>support@streamflux.app</span></p>
</div>
</div>
</div>;
}

function OutreachApp({user,onLogout}){
const[lang,setLang]=useState(()=>{
const p=new URLSearchParams(window.location.search);
return p.get("lang")||localStorage.getItem("nt_lang")||"English";
});
const[loading,setLoading]=useState(false);
const[loadingMsg,setLoadingMsg]=useState("");
const[result,setResult]=useState(null);
const[error,setError]=useState("");
const[tab,setTab]=useState("messages");

const[contactType,setContactType]=useState("");
const[contactReason,setContactReason]=useState("");
const[tone,setTone]=useState("");
const[objection,setObjection]=useState("");
const[exactObjection,setExactObjection]=useState("");

const[contactName,setContactName]=useState("");
const[hairProblems,setHairProblems]=useState([]);
const[products,setProducts]=useState([]);
const[partnerTargets,setPartnerTargets]=useState([]);
const[priorContact,setPriorContact]=useState("");
const[personalNote,setPersonalNote]=useState("");

const[yourName,setYourName]=useState(user.name||"");
const[yourPhone,setYourPhone]=useState("");
const[yourLink,setYourLink]=useState("");

const isPartner=contactType==="potential_partner"||contactType==="past_partner";
const isObjection=contactReason==="handle_objection";
const canGenerate=contactName&&contactType&&contactReason&&tone&&yourName;

const ctx=`
CONTACT:
- Name: ${contactName}
- Type: ${CONTACT_TYPES.find(t=>t.value===contactType)?.label||contactType}
- Reason for outreach: ${CONTACT_REASONS.find(r=>r.value===contactReason)?.label||contactReason}
- Tone: ${TONES.find(t=>t.value===tone)?.label||tone}
- Prior contact: ${priorContact||"none specified"}
- Personal note: ${personalNote||"none"}
${isObjection?`- Objection category: ${OBJECTIONS.find(o=>o.value===objection)?.label||objection}${exactObjection?`\n- Their exact words: "${exactObjection}"`:""}`:""}
${hairProblems.length>0?`- Hair/skin problems: ${hairProblems.join(", ")}`:""}
${products.length>0?`- Products to promote: ${products.join(", ")}`:""}
${isPartner&&partnerTargets.length>0?`- Why they'd be a good partner: ${partnerTargets.join(", ")}`:""}

MARKET PARTNER (sender):
- Name: ${yourName}${yourPhone?" | "+yourPhone:""}${yourLink?" | "+yourLink:""}

MONAT CONTEXT: "We Are Modern Nature" | #1 Direct Seller Premium Haircare | $3.4B+ revenue | 100+ millionaires | 17 countries | Leaping Bunny certified | Paraben-free | Made in USA | Top 5 haircare on TikTok Shop
${isPartner?`\nPARTNER OPPORTUNITY: Earn up to 5x/month | $1.5B+ paid to partners | Work from home | Be your own boss | 17 countries | Community of winners`:""}`.trim();

const langNote=lang!=="English"?`\n\nCRITICAL: Write ALL content in ${lang==="Mexican"?"Mexican Spanish — use Mexican expressions and phrases natural to Mexico, not Spain Spanish":lang}. Every single word must be in that language.`:"";

const generate=async()=>{
setError("");setLoading(true);setResult(null);

let p1Prompt="";
if(isObjection){
p1Prompt=`You are an elite MONAT network marketing coach. Write objection-handling responses.

${ctx}${langNote}

Return ONLY raw JSON (no markdown, no backticks):
{
"whatsapp": "WhatsApp response. 60-80 words. If exact words were provided, respond directly to those specific words — not generic. Acknowledge their concern genuinely and specifically, reframe positively, keep door open. End with one soft question. Never pushy.",
"sms": "SMS response. Max 160 characters. Warm, understanding, not pushy.",
"voice_script": "Phone script. OPENING: acknowledge their position warmly by name. EMPATHY: show you understand their concern completely. REFRAME: offer a new perspective or relevant MONAT fact they may not know. QUESTION: ask one soft discovery question to understand their real concern. CLOSE: suggest a low-commitment next step. Label each section clearly.",
"email_subject": "Email subject that doesn't feel like a sales email. Under 9 words.",
"email_body": "140-160 word email. Handle the objection gracefully. Acknowledge, provide real value, keep the relationship. Signed by ${yourName}."
}`;
} else {
p1Prompt=`You are an elite MONAT network marketing coach. Write highly personalised outreach messages.

${ctx}${langNote}

Return ONLY raw JSON (no markdown, no backticks):
{
"whatsapp": "WhatsApp message. 60-90 words. Warm, personal, use ${contactName}'s first name. Reference their specific situation or problem. Build curiosity naturally. End with one easy question. Never salesy. Feels like a real friend sharing something.",
"sms": "SMS message. Max 160 characters. Punchy and personal. Use their first name. Clear but soft CTA.",
"voice_script": "Phone call script. OPENING: greet ${contactName} warmly, introduce yourself if needed. REASON FOR CALL: why you're calling specifically for them. VALUE: what's in it for them specifically. CLOSE: ask for one specific low-commitment next step. Label each section clearly. Natural spoken language, not scripted-sounding.",
"email_subject": "Email subject line. Personal and curiosity-driving. Under 10 words.",
"email_body": "Full email. 140-170 words. Personal opener referencing their situation. Middle section on the specific value for them. Clear CTA. Signed by ${yourName}${yourLink?" | "+yourLink:""}."
}`;
}

try{
setLoadingMsg("✦ Writing messages & voice script...");
const part1=await callClaude(p1Prompt,1300);

setLoadingMsg("✦ Writing letter & follow-ups...");
const p2Prompt=`You are an elite MONAT network marketing coach.

${ctx}${langNote}

Return ONLY raw JSON (no markdown, no backticks):
{
"formal_letter": "Full formal letter. Format:\\n[Date]\\n\\n${contactName}\\n[Their Address]\\n\\nDear ${contactName},\\n\\nParagraph 1: warm personal opening and reason for writing.\\nParagraph 2: the specific opportunity or product for their situation.\\nParagraph 3: why now is the right moment.\\nParagraph 4: warm close with a clear next step.\\n\\nWarm regards,\\n${yourName}${yourPhone?"\\n"+yourPhone:""}${yourLink?"\\n"+yourLink:""}. Total 260-300 words.",
"followup_1": "Follow-up message. Day 3 — no reply. 50-65 words. Friendly nudge from a different angle. End with easy question.",
"followup_2": "Follow-up message. Week 1 — no reply. 50-65 words. New angle or MONAT fact. Light urgency.",
"followup_3": "Follow-up message. Week 2 — no reply. 40-55 words. Very casual check-in. Zero pressure. Keep door open.",
"followup_4": "Follow-up message. Month 1 — no reply. 40-50 words. Final warm touch. No pressure. Just keeping in touch as a friend."
}`;
const part2=await callClaude(p2Prompt,1400);

setLoadingMsg("✦ Building your follow-up schedule...");
const p3Prompt=`You are an elite MONAT network marketing coach. Create a practical follow-up schedule.

CONTACT: ${contactName} | TYPE: ${CONTACT_TYPES.find(t=>t.value===contactType)?.label} | REASON: ${CONTACT_REASONS.find(r=>r.value===contactReason)?.label}${langNote}

Return ONLY raw JSON (no markdown, no backticks):
{"schedule":[
{"day":"Today — First Contact","icon":"🚀","tasks":["Send the WhatsApp message","If no reply after 3 hours, send the SMS as well","Note the contact in your records with today's date"]},
{"day":"Day 3 — First Follow-Up","icon":"💬","tasks":["Send Follow-Up #1 if no reply","Check if they viewed your message — call if they did","Note their response or silence"]},
{"day":"Day 7 — Week 1 Check-In","icon":"📞","tasks":["Send Follow-Up #2 with a fresh angle","Make a phone call using your voice script","Listen first — ask questions before sharing anything"]},
{"day":"Day 14 — Two Week Touch","icon":"🔄","tasks":["Send Follow-Up #3 — casual, zero pressure","Share a relevant before/after or result if you have one","Update your records with their current status"]},
{"day":"Day 30 — Monthly Touch","icon":"🌱","tasks":["Send Follow-Up #4 — final warm message","If still no reply, add to monthly check-in list","Timing is everything — stay patient and consistent"]},
{"day":"Ongoing — Stay Top of Mind","icon":"📅","tasks":["Share occasional MONAT results or updates on your WhatsApp Status","Tag them in relevant content if appropriate","Check in every 90 days — life situations change"]}
]}`;
const part3=await callClaude(p3Prompt,900);

setResult({...part1,...part2,...part3});
setTab("messages");
}catch(e){setError("Error: "+e.message);}
setLoading(false);setLoadingMsg("");
};

const card={background:G.card,border:`1px solid ${G.border}`,borderRadius:14,padding:"22px",marginBottom:16};
const btnP=(d)=>({background:d?"#1a1a2e":G.purple,color:d?G.muted:"#fff",border:"none",borderRadius:10,padding:"13px 22px",fontSize:14,fontWeight:700,cursor:d?"not-allowed":"pointer"});
const btnS={background:"transparent",color:G.muted,border:`1px solid ${G.border}`,borderRadius:10,padding:"13px 22px",fontSize:14,cursor:"pointer"};

const Hdr=()=><header style={{background:G.card,borderBottom:`1px solid ${G.border}`,padding:"0 18px",height:54,display:"flex",alignItems:"center",justifyContent:"space-between",position:"sticky",top:0,zIndex:50}}>
<div style={{display:"flex",alignItems:"center",gap:9}}>
<div style={{width:30,height:30,borderRadius:8,background:G.purpleDim,border:`1px solid ${G.purple}`,display:"flex",alignItems:"center",justifyContent:"center",color:"#b8aff0",fontSize:13}}>✦</div>
<div><div style={{fontSize:13,fontWeight:"bold",letterSpacing:2,color:G.text}}>Network Tools</div><div style={{fontSize:8,color:G.purple,letterSpacing:2,textTransform:"uppercase"}}>Outreach Machine · by Streamflux</div></div>
</div>
<div style={{display:"flex",alignItems:"center",gap:7}}>
{user.trialActive&&<span style={{fontSize:10,color:G.purple,background:G.purpleDim,borderRadius:10,padding:"3px 8px"}}>⏰ {user.daysLeft}d left</span>}
<span style={{fontSize:10,color:G.purple,background:G.purpleDim,borderRadius:10,padding:"3px 8px"}}>{lang}</span>
<button onClick={onLogout} style={{...btnS,padding:"4px 10px",fontSize:10}}>Log Out</button>
</div>
</header>;

if(result){
return <div style={{minHeight:"100vh",background:G.bg,color:G.text}}>
<Hdr/>
<div style={{maxWidth:720,margin:"0 auto",padding:"20px 14px 60px"}}>
<div style={{background:G.purpleDim,border:`1px solid ${G.purple}`,borderRadius:12,padding:"12px 16px",marginBottom:16,display:"flex",justifyContent:"space-between",alignItems:"center",flexWrap:"wrap",gap:8}}>
<span style={{fontSize:13,color:"#b8aff0",fontWeight:"bold"}}>✦ Outreach Package for {contactName}</span>
<div style={{display:"flex",gap:8,alignItems:"center"}}>
<span style={{fontSize:11,color:G.muted}}>{lang}</span>
<button onClick={()=>{setResult(null);setError("");}} style={{...btnS,padding:"5px 12px",fontSize:11}}>← New Message</button>
</div>
</div>
<p style={{color:G.muted,fontSize:13,margin:"0 0 16px"}}>Every message personalised for {contactName}. Tap Copy and send.</p>
<div style={{display:"flex",gap:6,marginBottom:18,flexWrap:"wrap"}}>
{TABS.map(t=><button key={t.id} onClick={()=>setTab(t.id)} style={{background:tab===t.id?G.purple:"#0d1017",color:tab===t.id?"#fff":G.muted,border:`1px solid ${tab===t.id?G.purple:G.border}`,borderRadius:8,padding:"7px 13px",fontSize:11,fontWeight:tab===t.id?700:400,cursor:"pointer"}}>{t.label}</button>)}
</div>
{tab==="messages"&&<><OutCard title="WhatsApp Message" badge="WhatsApp" content={result.whatsapp}/><OutCard title="SMS Message" badge="160 chars" content={result.sms}/></>}
{tab==="voice"&&<><p style={{color:G.muted,fontSize:13,margin:"0 0 12px"}}>Read naturally — don't sound like you're reading a script.</p><OutCard title="Phone Call Script" content={result.voice_script}/></>}
{tab==="email"&&<><OutCard title="Email Subject Line" content={result.email_subject}/><OutCard title="Email Body" content={result.email_body}/></>}
{tab==="letter"&&<><p style={{color:G.muted,fontSize:13,margin:"0 0 12px"}}>Replace anything in brackets before printing.</p><OutCard title="Formal Letter" content={result.formal_letter}/></>}
{tab==="followups"&&<><p style={{color:G.muted,fontSize:13,margin:"0 0 12px"}}>Send in order if no reply. Works on WhatsApp and SMS.</p><OutCard title="Follow-Up #1" badge="Day 3" content={result.followup_1}/><OutCard title="Follow-Up #2" badge="Week 1" content={result.followup_2}/><OutCard title="Follow-Up #3" badge="Week 2" content={result.followup_3}/><OutCard title="Follow-Up #4" badge="Month 1" content={result.followup_4}/></>}
{tab==="schedule"&&<>
<p style={{color:G.muted,fontSize:13,margin:"0 0 16px"}}>Your exact follow-up plan for {contactName}. Never miss a touchpoint.</p>
{result.schedule?.map((d,i)=><div key={i} style={{background:"#0d1017",border:`1px solid ${G.border}`,borderRadius:10,padding:"15px 17px",marginBottom:12}}>
<div style={{display:"flex",alignItems:"center",gap:9,marginBottom:10}}><span style={{fontSize:20}}>{d.icon}</span><span style={{fontSize:13,fontWeight:700,color:G.purple}}>{d.day}</span></div>
{d.tasks?.map((t,j)=><div key={j} style={{display:"flex",gap:9,alignItems:"flex-start",marginBottom:6}}><span style={{color:G.purple,fontWeight:700,flexShrink:0}}>→</span><span style={{fontSize:13,color:"#d1d5db",lineHeight:1.6}}>{t}</span></div>)}
</div>)}
</>}
</div>
</div>;
}

return <div style={{minHeight:"100vh",background:G.bg,color:G.text}}>
<Hdr/>
<div style={{maxWidth:660,margin:"0 auto",padding:"22px 14px 60px"}}>

<div style={card}>
<h2 style={{margin:"0 0 4px",fontSize:16,fontWeight:700}}>👤 Who Are You Contacting?</h2>
<p style={{color:G.muted,fontSize:13,margin:"0 0 18px"}}>The more detail, the more personalised the messages.</p>
<Field label="Their First Name" value={contactName} onChange={setContactName} placeholder="Maria"/>
<Chips label="Contact Type" opts={CONTACT_TYPES} sel={contactType} toggle={setContactType} single/>
<Chips label="Reason for Reaching Out" hint="Why are you contacting them right now?" opts={CONTACT_REASONS} sel={contactReason} toggle={setContactReason} single/>
<Chips label="Communication Tone" hint="How should the messages feel?" opts={TONES} sel={tone} toggle={setTone} single/>
</div>

{isObjection&&<div style={card}>
<h2 style={{margin:"0 0 4px",fontSize:16,fontWeight:700}}>🛡️ What Objection Did They Raise?</h2>
<p style={{color:G.muted,fontSize:13,margin:"0 0 16px"}}>Select the category and optionally paste their exact words for a much more powerful response.</p>
<Chips label="Objection Category" opts={OBJECTIONS} sel={objection} toggle={setObjection} single/>
<div style={{marginTop:14}}>
<label style={{display:"block",fontSize:10,fontWeight:700,letterSpacing:"0.1em",color:G.muted,textTransform:"uppercase",marginBottom:4}}>Their Exact Words <span style={{fontSize:10,fontWeight:400,color:"#4b5563"}}>(optional but recommended)</span></label>
<p style={{fontSize:11,color:"#4b5563",margin:"0 0 6px",fontStyle:"italic"}}>Paste exactly what they said — the AI will respond to their specific words</p>
<textarea value={exactObjection} onChange={e=>setExactObjection(e.target.value)} placeholder='e.g. "I tried MONAT before and my hair fell out" or "I don't believe in MLM, it's a pyramid scheme"' rows={3} style={{width:"100%",background:"#0d1017",border:`1px solid ${G.border}`,borderRadius:8,color:G.text,fontSize:14,padding:"11px 14px",outline:"none",boxSizing:"border-box",fontFamily:"inherit",resize:"vertical"}}/>
</div>
</div>}

<div style={card}>
<h2 style={{margin:"0 0 4px",fontSize:16,fontWeight:700}}>💇 Their Hair & Skin Situation</h2>
<p style={{color:G.muted,fontSize:13,margin:"0 0 16px"}}>Select their problems — the AI will tailor content around them.</p>
<Chips label="Their Hair / Skin Problems" hint="Select all that apply" opts={HAIR_PROBLEMS} sel={hairProblems} toggle={v=>setHairProblems(prev=>prev.includes(v)?prev.filter(x=>x!==v):[...prev,v])}/>
<Chips label="Products to Mention" hint="Optional — focus on specific products" opts={PRODUCTS} sel={products} toggle={v=>setProducts(prev=>prev.includes(v)?prev.filter(x=>x!==v):[...prev,v])}/>
</div>

{isPartner&&<div style={card}>
<h2 style={{margin:"0 0 4px",fontSize:16,fontWeight:700}}>🚀 Why Would They Be a Great Partner?</h2>
<p style={{color:G.muted,fontSize:13,margin:"0 0 16px"}}>Select what applies — the AI will speak directly to their motivation.</p>
<Chips label="Their Profile" opts={PARTNER_TARGETS} sel={partnerTargets} toggle={v=>setPartnerTargets(prev=>prev.includes(v)?prev.filter(x=>x!==v):[...prev,v])}/>
</div>}

<div style={card}>
<h2 style={{margin:"0 0 4px",fontSize:16,fontWeight:700}}>💡 Personal Context</h2>
<p style={{color:G.muted,fontSize:13,margin:"0 0 16px"}}>Personal details make messages feel real — not copy-paste.</p>
<Field label="Prior Contact History" hint="Have you spoken before? What did they say?" value={priorContact} onChange={setPriorContact} placeholder="Met at a MONAT event 2 weeks ago. Said she was interested but wanted to think about it." rows={2}/>
<Field label="Personal Note" hint="Kids, job, lifestyle — anything personal you know about them" value={personalNote} onChange={setPersonalNote} placeholder="Has 2 young kids, recently went back to work, mentioned her hair has been really dry since having kids." rows={2}/>
</div>

<div style={card}>
<h2 style={{margin:"0 0 4px",fontSize:16,fontWeight:700}}>🏷️ Your Details</h2>
<p style={{color:G.muted,fontSize:13,margin:"0 0 16px"}}>Used in sign-offs, letters and the voice script.</p>
<div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12}}>
<Field label="Your Name" value={yourName} onChange={setYourName} placeholder="Maria Johnson"/>
<Field label="Your WhatsApp / Phone" value={yourPhone} onChange={setYourPhone} placeholder="+1 (555) 000-0000"/>
</div>
<Field label="Your MONAT Shop Link" value={yourLink} onChange={setYourLink} placeholder="yourname.mymonat.com"/>
</div>

{error&&<div style={{background:G.redLight,border:"1px solid #3a1a1a",borderRadius:8,padding:"12px 14px",color:"#f87171",fontSize:13,marginBottom:14}}>⚠ {error}</div>}

{loading&&<div style={{background:G.card,border:`1px solid ${G.border}`,borderRadius:10,padding:"16px 20px",marginBottom:14,textAlign:"center"}}>
<p style={{color:G.purple,fontSize:14,margin:0,fontWeight:600}}>{loadingMsg}</p>
<p style={{color:G.muted,fontSize:12,margin:"6px 0 0"}}>Generating in {lang}. Takes about 20 seconds...</p>
</div>}

<button onClick={()=>canGenerate&&!loading&&generate()} disabled={loading||!canGenerate} style={{...btnP(!canGenerate||loading),width:"100%",fontSize:15}}>
{loading?"Generating...":"✦ Generate Full Outreach Package"}
</button>
{!canGenerate&&<p style={{color:G.muted,fontSize:12,marginTop:8,textAlign:"center"}}>Fill in their name, contact type, reason, tone and your name to continue.</p>}

<div style={{marginTop:32,textAlign:"center"}}>
<div style={{fontSize:8,letterSpacing:2,color:"#1e2330",textTransform:"uppercase"}}>Network Tools by Streamflux</div>
<div style={{fontSize:8,color:"#1e2330",marginTop:2}}>Powered by Claude AI · streamflux.app</div>
</div>
</div>
</div>;
}

function Root(){
const[user,setUser]=useState(null);
const[checking,setChecking]=useState(true);
useEffect(()=>{
const s=localStorage.getItem("nt_u");
if(s){try{const u=JSON.parse(s);callAuth({action:"check",userId:u.id}).then(d=>{if(d.success)setUser(d.user);else localStorage.removeItem("nt_u");setChecking(false);}).catch(()=>setChecking(false));}catch{setChecking(false);}}
else setChecking(false);
},[]);
const logout=()=>{localStorage.removeItem("nt_u");setUser(null);};
if(checking)return<div style={{minHeight:"100vh",background:G.bg,display:"flex",alignItems:"center",justifyContent:"center"}}><div style={{textAlign:"center"}}><div style={{width:44,height:44,borderRadius:11,background:G.purpleDim,border:`1px solid ${G.purple}`,display:"flex",alignItems:"center",justifyContent:"center",fontSize:20,color:"#b8aff0",margin:"0 auto 10px"}}>✦</div><div style={{fontSize:12,color:G.muted}}>Loading...</div></div></div>;
if(!user)return<Login onLogin={setUser}/>;
return<OutreachApp user={user} onLogout={logout}/>;
}

ReactDOM.createRoot(document.getElementById('root')).render(<Root/>);
</script>
</body>
</html>

